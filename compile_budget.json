{
  "$comment": [
    "Versioned compile-time budget baseline. Source-of-truth for the numbers",
    "is docs/rules/compile-budget.md; this file is the machine-readable mirror",
    "that scripts/check-compile-budget.sh consumes via scripts/measure-tu.sh.",
    "Update both files in the same commit (see docs/rules/docs-in-sync.md).",
    "",
    "Reference hardware: GCC 16.1, x86_64 Linux, 8 cores, 16 GB RAM, NVMe SSD,",
    "release mode (LTO on), -j$(nproc). Measurements on slower hardware will",
    "exceed these numbers; that is expected. CI runs on the reference baseline.",
    "",
    "Schema:",
    "  categories.<oran-lib>      — per-library per-TU budget triple.",
    "    median_sec, p95_sec, hard_cap_sec",
    "      Wall-clock seconds for a single cc1plus invocation, single sample,",
    "      release mode with the library's PCH cached.",
    "  targets.<phase>            — per-phase whole-build budget.",
    "    target_sec, hard_cap_sec",
    "      Wall-clock seconds. The current scripts/check-compile-budget.sh",
    "      gates only on categories.* hard caps; the targets.* section is",
    "      captured for the future per-target gate."
  ],
  "schema_version": 1,
  "categories": {
    "oran-core":         { "median_sec": 0.8, "p95_sec": 1.5, "hard_cap_sec": 2.0 },
    "oran-log":          { "median_sec": 0.8, "p95_sec": 1.5, "hard_cap_sec": 2.0 },
    "oran-io":           { "median_sec": 0.8, "p95_sec": 1.5, "hard_cap_sec": 2.0 },
    "oran-async":        { "median_sec": 1.0, "p95_sec": 2.0, "hard_cap_sec": 2.5 },
    "oran-http":         { "median_sec": 1.0, "p95_sec": 2.0, "hard_cap_sec": 2.5 },
    "oran-storage":      { "median_sec": 1.0, "p95_sec": 2.0, "hard_cap_sec": 2.5 },
    "oran-config":       { "median_sec": 1.0, "p95_sec": 2.0, "hard_cap_sec": 2.5 },
    "oran-permission":   { "median_sec": 1.0, "p95_sec": 2.0, "hard_cap_sec": 2.5 },
    "oran-skill":        { "median_sec": 1.0, "p95_sec": 2.0, "hard_cap_sec": 2.5 },
    "oran-tool":         { "median_sec": 1.2, "p95_sec": 2.5, "hard_cap_sec": 3.0 },
    "oran-memory":       { "median_sec": 1.2, "p95_sec": 2.5, "hard_cap_sec": 3.0 },
    "oran-hook":         { "median_sec": 1.2, "p95_sec": 2.5, "hard_cap_sec": 3.0 },
    "oran-provider":     { "median_sec": 1.5, "p95_sec": 3.0, "hard_cap_sec": 3.5 },
    "oran-prompt":       { "median_sec": 1.5, "p95_sec": 3.0, "hard_cap_sec": 3.5 },
    "oran-agent":        { "median_sec": 1.5, "p95_sec": 3.0, "hard_cap_sec": 3.5 },
    "oran-orchestration":{ "median_sec": 1.5, "p95_sec": 3.0, "hard_cap_sec": 3.5 },
    "oran-automation":   { "median_sec": 1.5, "p95_sec": 3.0, "hard_cap_sec": 3.5 },
    "oran-channel":      { "median_sec": 1.2, "p95_sec": 2.5, "hard_cap_sec": 3.0 },
    "oran-channel-qq":   { "median_sec": 1.2, "p95_sec": 2.5, "hard_cap_sec": 3.0 },
    "oran-web":          { "median_sec": 1.5, "p95_sec": 3.0, "hard_cap_sec": 4.0 },
    "oran-cli":          { "median_sec": 1.5, "p95_sec": 3.0, "hard_cap_sec": 4.0 },
    "oran-bootstrap":    { "median_sec": 2.0, "p95_sec": 4.0, "hard_cap_sec": 5.0 }
  },
  "targets": {
    "configure":                       { "target_sec":  5, "hard_cap_sec": 20 },
    "build_all_libs":                  { "target_sec": 25, "hard_cap_sec": 45 },
    "build_all_binaries":              { "target_sec": 30, "hard_cap_sec": 55 },
    "link_orangutan_binary":           { "target_sec":  5, "hard_cap_sec": 10 },
    "clean_build_release":             { "target_sec": 30, "hard_cap_sec": 60 },
    "incremental_after_one_cpp":       { "target_sec":  3, "hard_cap_sec": 10 },
    "incremental_after_one_header":    { "target_sec":  8, "hard_cap_sec": 20 },
    "tests_build_delta":               { "target_sec": 15, "hard_cap_sec": 30 },
    "bench_build_delta":               { "target_sec": 10, "hard_cap_sec": 20 }
  }
}
