{
  "strict_config": false,
  "runtime": {
    "workers": 4,
    "request_timeout_ms": 600000,
    "tool_output": {
      "max_text_bytes": 262144,
      "max_data_bytes": 1048576
    },
    "tool_scheduler": {
      "max_parallel_tools": 4,
      "per_call_timeout_ms": 60000
    },
    "stream": {
      "max_bytes": 16777216
    },
    "prompt": {
      "active_tools": "defaults"
    }
  },
  "trace": {
    "enabled": true
  },
  "profiles": {
    "default": {
      "provider": "anthropic",
      "protocol": "anthropic_messages",
      "model": "${ORAN_DEFAULT_MODEL:-claude-3-5-sonnet-latest}",
      "base_url": "https://api.anthropic.com",
      "api_key_env": "ANTHROPIC_API_KEY",
      "pricing": {
        "input_per_million_usd": 3.0,
        "output_per_million_usd": 15.0,
        "cache_creation_per_million_usd": 3.75,
        "cache_read_per_million_usd": 0.3
      },
      "thinking_budget": 1024,
      "cache": {
        "enabled": true,
        "min_prefix_bytes": 512
      }
    }
  },
  "routes": {
    "default": {
      "primary": "default",
      "fallbacks": []
    }
  },
  "permissions": {
    "workspace": {
      "extra_read_roots": [],
      "extra_write_roots": []
    },
    "allow": [
      {
        "tool_pattern": "FileRead"
      },
      {
        "tool_pattern": "*",
        "capability": "read_memory"
      }
    ],
    "deny": [
      {
        "tool_pattern": "*",
        "capability": "runtime_loader"
      },
      {
        "tool_pattern": "ShellExec",
        "input_pattern": "^rm -rf"
      },
      {
        "tool_pattern": "ShellExec",
        "input_pattern": "^git push"
      }
    ],
    "ask": [
      {
        "tool_pattern": "FileWrite"
      },
      {
        "tool_pattern": "*",
        "capability": "spawn_subprocess"
      }
    ]
  },
  "agents": {
    "researcher": {
      "prompt_overlay": "Prefer concise, source-backed answers and call out uncertain evidence.",
      "permissions": {
        "allow": [
          {
            "tool_pattern": "*",
            "capability": "egress_http"
          }
        ]
      }
    }
  },
  "hooks": {
    "timeout_ms": 2000
  },
  "memory": {
    "longterm": {
      "recall": {
        "enabled": false,
        "limit": 5,
        "kinds": [
          "user",
          "feedback",
          "project",
          "reference",
          "team"
        ]
      }
    }
  }
}
