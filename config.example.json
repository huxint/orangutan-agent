{
  "strict_config": false,
  "runtime": {
    "workers": 4,
    "request_timeout_ms": 600000,
    "redaction_patterns": [
      "(?i)(api[_-]?key)[=:][^\\s]+",
      "Bearer [A-Za-z0-9_.-]+"
    ]
  },
  "profiles": {
    "default": {
      "provider": "anthropic",
      "model": "${ORAN_DEFAULT_MODEL:-claude-3-5-sonnet-latest}",
      "base_url": "https://api.anthropic.com",
      "api_key_env": "ANTHROPIC_API_KEY"
    }
  },
  "routes": {
    "default": {
      "primary": "default",
      "fallbacks": []
    }
  },
  "permissions": {},
  "agents": {},
  "teams": {},
  "channels": [],
  "hooks": {},
  "memory": {},
  "automation": {},
  "web": {
    "enabled": false,
    "bind": "127.0.0.1",
    "port": 8787
  },
  "session": {
    "auto_save": true,
    "persistence": true
  }
}
