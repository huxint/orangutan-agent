{
  "strict_config": false,
  "runtime": {
    "workers": 4,
    "request_timeout_ms": 600000,
    "tool_output": {
      "max_text_bytes": 262144,
      "max_data_bytes": 1048576
    },
    "tool_scheduler": {
      "max_parallel_tools": 4,
      "per_call_timeout_ms": 60000,
      "idle_lock_ttl_ms": 300000
    },
    "prompt": {
      "active_tools": "defaults"
    },
    "redaction_patterns": [
      "(?i)(api[_-]?key)[=:][^\\s]+",
      "Bearer [A-Za-z0-9_.-]+"
    ]
  },
  "trace": {
    "enabled": true,
    "store_raw_bodies": false,
    "retention_days": 30
  },
  "profiles": {
    "default": {
      "provider": "anthropic",
      "protocol": "anthropic_messages",
      "model": "${ORAN_DEFAULT_MODEL:-claude-3-5-sonnet-latest}",
      "base_url": "https://api.anthropic.com",
      "api_key_env": "ANTHROPIC_API_KEY",
      "pricing": {
        "input_per_million_usd": 3.0,
        "output_per_million_usd": 15.0,
        "cache_creation_per_million_usd": 3.75,
        "cache_read_per_million_usd": 0.3
      }
    }
  },
  "routes": {
    "default": {
      "primary": "default",
      "fallbacks": []
    }
  },
  "permissions": {
    "workspace": {
      "extra_read_roots": [],
      "extra_write_roots": []
    },
    "allow": [
      {"tool_pattern": "file.read"},
      {"tool_pattern": "file.search"},
      {"tool_pattern": "*", "capability": "read_memory"}
    ],
    "deny": [
      {"tool_pattern": "*", "capability": "runtime_loader"},
      {"tool_pattern": "shell.exec", "input_pattern": "^rm -rf"},
      {"tool_pattern": "shell.exec", "input_pattern": "^git push"}
    ],
    "ask": [
      {"tool_pattern": "file.write"},
      {"tool_pattern": "*", "capability": "spawn_subprocess"}
    ]
  },
  "agents": {
    "researcher": {
      "prompt_overlay": "Prefer concise, source-backed answers and call out uncertain evidence.",
      "skills_enabled": ["release-note", "review-pr"],
      "skills_deactivated": ["review-pr"],
      "skills_expirations": [
        {"name": "release-note", "expires_at": "2026-12-31T23:59:59Z"}
      ],
      "permissions": {
        "allow": [
          {"tool_pattern": "*", "capability": "egress_http"}
        ]
      }
    }
  },
  "teams": {},
  "channels": [],
  "hooks": {
    "timeout_ms": 2000
  },
  "memory": {
    "longterm": {
      "recall": {
        "enabled": false,
        "limit": 5,
        "query_strategy": "prompt_text",
        "kinds": ["user", "feedback", "project", "reference", "team"]
      },
      "hybrid_search": {
        "enabled": false,
        "lexical_limit": 10,
        "vector_limit": 10,
        "result_limit": 10,
        "lexical_weight": 1.0,
        "vector_weight": 1.0
      },
      "retention": {
        "forget_after_unused_days": 180,
        "importance_floor": 0.0,
        "max_records_per_scope": 10000,
        "decay_check_interval_hours": 24
      }
    }
  },
  "automation": {
    "cron": {
      "jobs": [
        {
          "job_key": "daily-summary",
          "agent_key": "researcher",
          "expression": "0 9 * * *",
          "first_fire_at": "2026-06-08T09:00:00Z"
        }
      ]
    }
  },
  "web": {
    "enabled": false,
    "bind": "127.0.0.1",
    "port": 8787
  },
  "session": {
    "auto_save": true,
    "persistence": true
  }
}
