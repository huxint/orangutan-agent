#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "${repo_root}"

staged_paths() {
  git diff --cached --name-only -z --diff-filter=ACMR -- "$@"
}

collect_existing() {
  local -n out=$1
  shift

  local path
  while IFS= read -r -d '' path; do
    [[ -f "${path}" ]] && out+=("${path}")
  done < <(staged_paths "$@")
}

staged_cpp=()
collect_existing staged_cpp \
  '*.c' '*.cc' '*.cpp' '*.cxx' '*.h' '*.hh' '*.hpp' '*.hxx' '*.ixx' '*.cppm'

if (( ${#staged_cpp[@]} > 0 )); then
  if ! command -v clang-format >/dev/null 2>&1; then
    echo "pre-commit: clang-format is required for staged C/C++ files." >&2
    exit 1
  fi

  dirty_cpp=()
  for path in "${staged_cpp[@]}"; do
    if ! git diff --quiet -- "${path}"; then
      dirty_cpp+=("${path}")
    fi
  done

  if (( ${#dirty_cpp[@]} > 0 )); then
    echo "pre-commit: refusing to format staged C/C++ files that also have unstaged changes:" >&2
    printf '  %s\n' "${dirty_cpp[@]}" >&2
    echo "Stage or stash those unstaged hunks first, then commit again." >&2
    exit 1
  fi

  clang-format -i -- "${staged_cpp[@]}"
  git add -- "${staged_cpp[@]}"
  echo "pre-commit: clang-format checked staged C/C++ files"
fi

staged_shell=()
collect_existing staged_shell '*.sh'

if (( ${#staged_shell[@]} > 0 )); then
  if ! command -v shfmt >/dev/null 2>&1; then
    echo "pre-commit: shfmt is required for staged shell files." >&2
    exit 1
  fi

  if ! shfmt -d "${staged_shell[@]}"; then
    echo "pre-commit: shell formatting differs; run shfmt -w on the files above." >&2
    exit 1
  fi
fi

"${repo_root}/scripts/check-secret-logs.sh"
